# ---------------------------------------------------------------------------
# Mini-SOC — cấu hình qua biến môi trường.
# Copy file này thành `.env` rồi sửa. KHÔNG commit `.env` lên git.
# ---------------------------------------------------------------------------

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=minisoc
POSTGRES_PASSWORD=doi_mat_khau_nay
POSTGRES_DB=minisoc
POSTGRES_PORT=5432

# Dùng khi chạy trong docker compose (host = tên service `postgres`).
# Chạy ngoài docker thì đổi `postgres` thành `127.0.0.1`.
DATABASE_URL=postgresql+psycopg://minisoc:doi_mat_khau_nay@postgres:5432/minisoc

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379

# --- Bảo mật ứng dụng -------------------------------------------------------
# Sinh khoá mới:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=doi_khoa_nay_truoc_khi_chay_that
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Tài khoản quản trị được tạo tự động lần đầu khởi động.
ADMIN_EMAIL=admin@minisoc.local
ADMIN_PASSWORD=ChangeMe#2026

# Khoá dùng chung cho agent khi đăng ký lần đầu (agent enrollment).
# Mỗi agent sau khi đăng ký sẽ nhận một API key riêng.
AGENT_ENROLL_TOKEN=doi_token_enroll_nay

# --- API --------------------------------------------------------------------
API_PORT=8000
# Origin của frontend, phân tách bằng dấu phẩy.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# --- Lớp phát hiện ----------------------------------------------------------
# Bật/tắt từng module độc lập (yêu cầu phi chức năng của đồ án).
ENABLE_RULE_ENGINE=true
ENABLE_RANSOMWARE_BEHAVIOR=true
# Để false cho tới khi bạn đã huấn luyện mô hình trên CIC-IDS2017 THẬT.
# Bật khi trong ml/artifacts còn mô hình huấn luyện từ dữ liệu tổng hợp nghĩa là
# đang chấm điểm bằng một mô hình không có giá trị thực tế.
ENABLE_ML_NETWORK=false
ENABLE_LLM_ASSISTANT=false

# --- Mô hình ML của lớp 2 ---------------------------------------------------
# Để trống khi chạy ngoài Docker (tự tìm ml/artifacts cạnh mã nguồn).
# Trong docker compose, biến này đã được đặt sẵn cho service worker.
ML_MODEL_DIR=
ML_MODEL_NAME=random_forest
# Chỉ báo động khi xác suất vượt ngưỡng. Đặt cao vì ở SMB không có người trực
# SOC, cảnh báo giả tốn kém hơn nhiều so với một lần bỏ sót.
ML_ALERT_THRESHOLD=0.80

# --- Lớp trợ lý AI (Tuần 3) -------------------------------------------------
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
# Ẩn danh hoá dữ liệu nhạy cảm trước khi gửi ra API bên ngoài.
LLM_ANONYMIZE=true

# --- Thông báo (Tuần 3) -----------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=minisoc@example.com
# Chỉ gửi thông báo từ mức này trở lên: low | medium | high | critical
NOTIFY_MIN_SEVERITY=high
